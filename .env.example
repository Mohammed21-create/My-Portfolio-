NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/portfolio
# Long random string (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Initial admin, created on first start only if no admin exists (password min 10 chars, letters + digits)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Yahaya Mohammed
# Password reset: set a random 24+ char token to ENABLE /api/auth/reset. Remove it when not needed.
ADMIN_RESET_TOKEN=
# Cloudinary (required in production). Either CLOUDINARY_URL or the three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
